```javascript
// ✅ Component Test
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import { DomainVerification } from './DomainVerification';

test('verifies domain successfully', async () => {
  const mockOnVerify = jest.fn();
  render(<DomainVerification domain="example.com" onVerify={mockOnVerify} />);
  
  const verifyButton = screen.getByText('Verify Domain');
  fireEvent.click(verifyButton);
  
  await waitFor(() => {
    expect(screen.getByText('Verifying...')).toBeInTheDocument();
  });
  
  await waitFor(() => {
    expect(mockOnVerify).toHaveBeenCalledWith(expect.objectContaining({
      verified: true,
      domain: 'example.com'
    }));
  });
});
