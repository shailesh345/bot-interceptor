### Domain Verification Logic
```python
# ✅ Verification Rules
class VerificationRule:
    def __init__(self, name, weight, condition):
        self.name = name
        self.weight = weight
        self.condition = condition
    
    def evaluate(self, domain_data):
        return self.condition(domain_data)

class DomainVerificationEngine:
    def __init__(self):
        self.rules = [
            VerificationRule("DNS Resolution", 0.3, self._check_dns),
            VerificationRule("SSL Certificate", 0.2, self._check_ssl),
            VerificationRule("Whois Data", 0.2, self._check_whois),
            VerificationRule("Reputation Check", 0.3, self._check_reputation)
        ]
    
    def verify_domain(self, domain):
        results = {}
        total_score = 0
        
        for rule in self.rules:
            try:
                rule_result = rule.evaluate(domain)
                results[rule.name] = rule_result
                total_score += rule.weight if rule_result else 0
            except Exception as e:
                logger.error(f"Rule {rule.name} failed: {e}")
                results[rule.name] = False
        
        return {
            'verified': total_score >= 0.7,
            'confidence': total_score,
            'details': results
        }
```

