// ✅ Component Structure
const DomainVerification = ({ domain, onVerify }) => {
  const [status, setStatus] = useState('idle');
  const [result, setResult] = useState(null);

  const handleVerification = async () => {
    setStatus('loading');
    try {
      const response = await verifyDomain(domain);
      setResult(response);
      onVerify(response);
    } catch (error) {
      setStatus('error');
      console.error('Verification failed:', error);
    }
  };

  return (
    <div className="domain-verification">
      <button 
        onClick={handleVerification}
        disabled={status === 'loading'}
        className="btn btn-primary"
      >
        {status === 'loading' ? 'Verifying...' : 'Verify Domain'}
      </button>
      {result && <VerificationResult result={result} />}
    </div>
  );
};

// ✅ API Service Pattern
const apiService = {
  async get(endpoint) {
    const response = await fetch(`/api${endpoint}`, {
      headers: { 'Authorization': `Bearer ${getToken()}` }
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json();
  },

  async post(endpoint, data) {
    const response = await fetch(`/api${endpoint}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${getToken()}`
      },
      body: JSON.stringify(data)
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json();
  }
};

// ✅ SaaS Bot Redirection Dashboard Component
const BotRedirectionDashboard = () => {
  const [botRedirects, setBotRedirects] = useState([]);
  const [revenueStats, setRevenueStats] = useState({});
  const [subscriptionStatus, setSubscriptionStatus] = useState({});
  const [isLoading, setIsLoading] = useState(false);

  const fetchBotRedirects = async () => {
    setIsLoading(true);
    try {
      const response = await apiService.get('/bot/redirects');
      setBotRedirects(response.data);
    } catch (error) {
      console.error('Failed to fetch bot redirects:', error);
    } finally {
      setIsLoading(false);
    }
  };

  const fetchRevenueStats = async () => {
    try {
      const response = await apiService.get('/billing/revenue');
      setRevenueStats(response.data);
    } catch (error) {
      console.error('Failed to fetch revenue stats:', error);
    }
  };

  const fetchSubscriptionStatus = async () => {
    try {
      const response = await apiService.get('/subscriptions/status');
      setSubscriptionStatus(response.data);
    } catch (error) {
      console.error('Failed to fetch subscription status:', error);
    }
  };

  useEffect(() => {
    fetchBotRedirects();
    fetchRevenueStats();
    fetchSubscriptionStatus();
    
    // Refresh data every 30 seconds
    const interval = setInterval(() => {
      fetchBotRedirects();
      fetchRevenueStats();
      fetchSubscriptionStatus();
    }, 30000);

    return () => clearInterval(interval);
  }, []);

  return (
    <div className="bot-redirection-dashboard">
      <div className="dashboard-header">
        <h2>Bot Redirection & Revenue Dashboard</h2>
        <button 
          onClick={fetchBotRedirects}
          disabled={isLoading}
          className="btn btn-primary"
        >
          {isLoading ? 'Refreshing...' : 'Refresh Data'}
        </button>
      </div>

      <div className="stats-grid">
        <div className="stat-card">
          <h3>Bot Redirects</h3>
          <p className="stat-number">{botRedirects.length}</p>
          <p className="stat-label">Last 24 hours</p>
        </div>
        
        <div className="stat-card">
          <h3>Revenue Generated</h3>
          <p className="stat-number">${revenueStats.totalRevenue || 0}</p>
          <p className="stat-label">This month</p>
        </div>
        
        <div className="stat-card">
          <h3>Conversion Rate</h3>
          <p className="stat-number">{revenueStats.conversionRate || 0}%</p>
          <p className="stat-label">Credit page conversions</p>
        </div>

        <div className="stat-card">
          <h3>Subscription Status</h3>
          <p className={`stat-number ${subscriptionStatus.status === 'active' ? 'text-success' : 'text-danger'}`}>
            {subscriptionStatus.status || 'inactive'}
          </p>
          <p className="stat-label">Current plan</p>
        </div>
      </div>

      <div className="credit-pages-section">
        <h3>Credit Pages Performance</h3>
        <div className="credit-pages-grid">
          {revenueStats.creditPages?.map((page, index) => (
            <div key={index} className="credit-page-card">
              <h4>{page.name}</h4>
              <p>Revenue: ${page.revenue}</p>
              <p>Conversions: {page.conversions}</p>
              <p>Conversion Rate: {page.conversionRate}%</p>
            </div>
          ))}
        </div>
      </div>

      <div className="bot-redirects-list">
        <h3>Recent Bot Redirects</h3>
        {botRedirects.map((redirect, index) => (
          <div key={index} className="redirect-item">
            <div className="redirect-info">
              <span className="bot-id">{redirect.bot_id}</span>
              <span className="credit-page">{redirect.credit_page_name}</span>
              <span className="revenue">${redirect.revenue_generated}</span>
            </div>
            <div className="redirect-details">
              <p>Original URL: {redirect.original_url}</p>
              <p>Redirect URL: {redirect.redirect_url}</p>
              <p>Timestamp: {new Date(redirect.timestamp).toLocaleString()}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
};

// ✅ Subscription Management Component
const SubscriptionManager = () => {
  const [subscription, setSubscription] = useState(null);
  const [plans, setPlans] = useState([]);
  const [usage, setUsage] = useState({});

  const fetchSubscription = async () => {
    try {
      const response = await apiService.get('/subscriptions/current');
      setSubscription(response.data);
    } catch (error) {
      console.error('Failed to fetch subscription:', error);
    }
  };

  const fetchPlans = async () => {
    try {
      const response = await apiService.get('/subscriptions/plans');
      setPlans(response.data);
    } catch (error) {
      console.error('Failed to fetch plans:', error);
    }
  };

  const fetchUsage = async () => {
    try {
      const response = await apiService.get('/subscriptions/usage');
      setUsage(response.data);
    } catch (error) {
      console.error('Failed to fetch usage:', error);
    }
  };

  const upgradePlan = async (planId) => {
    try {
      await apiService.post('/subscriptions/upgrade', { plan_id: planId });
      fetchSubscription();
    } catch (error) {
      console.error('Failed to upgrade plan:', error);
    }
  };

  useEffect(() => {
    fetchSubscription();
    fetchPlans();
    fetchUsage();
  }, []);

  return (
    <div className="subscription-manager">
      <h2>Subscription Management</h2>
      
      {subscription && (
        <div className="current-subscription">
          <h3>Current Plan: {subscription.plan_name}</h3>
          <p>Status: {subscription.status}</p>
          <p>Next Billing: {new Date(subscription.next_billing_date).toLocaleDateString()}</p>
        </div>
      )}

      <div className="usage-section">
        <h3>Usage This Month</h3>
        <div className="usage-grid">
          <div className="usage-item">
            <span>Bot Redirects: {usage.bot_redirects || 0} / {subscription?.limits?.bot_redirects || 0}</span>
            <div className="usage-bar">
              <div 
                className="usage-fill" 
                style={{width: `${((usage.bot_redirects || 0) / (subscription?.limits?.bot_redirects || 1)) * 100}%`}}
              ></div>
            </div>
          </div>
          <div className="usage-item">
            <span>Credit Pages: {usage.credit_pages || 0} / {subscription?.limits?.credit_pages || 0}</span>
            <div className="usage-bar">
              <div 
                className="usage-fill" 
                style={{width: `${((usage.credit_pages || 0) / (subscription?.limits?.credit_pages || 1)) * 100}%`}}
              ></div>
            </div>
          </div>
        </div>
      </div>

      <div className="plans-section">
        <h3>Available Plans</h3>
        <div className="plans-grid">
          {plans.map((plan, index) => (
            <div key={index} className="plan-card">
              <h4>{plan.name}</h4>
              <p className="price">${plan.price}/month</p>
              <ul>
                <li>{plan.limits.bot_redirects} bot redirects/month</li>
                <li>{plan.limits.credit_pages} credit pages</li>
                <li>{plan.features.join(', ')}</li>
              </ul>
              <button 
                onClick={() => upgradePlan(plan.id)}
                className="btn btn-primary"
                disabled={subscription?.plan_id === plan.id}
              >
                {subscription?.plan_id === plan.id ? 'Current Plan' : 'Upgrade'}
              </button>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};
```

