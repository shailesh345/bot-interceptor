            detection_methods.append('user_agent_analysis')
            bot_score += 0.3
        
        # Behavioral Analysis
        if self._check_behavioral_patterns(request_data):
            detection_methods.append('behavioral_analysis')
            bot_score += 0.4
        
        # Rate Limiting Check
        if self._check_rate_limiting(request_data.get('ip', '')):
            detection_methods.append('rate_limiting')
            bot_score += 0.2
        
