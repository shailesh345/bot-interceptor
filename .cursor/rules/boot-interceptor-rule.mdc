        result = bot_redirection_service.intercept_and_redirect_bot(request_data)
        
        # Log redirection for billing
        log_bot_redirection(request.tenant_id, result.bot_id, result.credit_page_url)
        
        return jsonify({
            'success': True,
            'data': {
                'bot_id': result.bot_id,
                'redirect_url': result.redirect_url,
                'credit_page_url': result.credit_page_url,
                'redirect_reason': result.redirect_reason,
                'timestamp': result.timestamp
            }
        }), 200
        
    except Exception as e:
        app.logger.error(f"Bot redirection failed: {e}")
