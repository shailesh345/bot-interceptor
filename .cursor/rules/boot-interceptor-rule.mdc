# ✅ Enhanced Revenue Analytics
class RevenueAnalyticsService:
    """Enhanced revenue analytics and reporting."""
    
    def __init__(self, db_session):
        self.db = db_session
    
    def get_revenue_summary(self, tenant_id: str, period: str = 'month') -> Dict[str, any]:
        """Get comprehensive revenue summary."""
        start_date, end_date = self._get_period_dates(period)
        
        # Get revenue data
        revenue_data = self.db.execute("""
            SELECT 
                DATE(created_at) as date,
                SUM(revenue_generated) as daily_revenue,
                COUNT(*) as redirects,
                AVG(revenue_generated) as avg_revenue_per_redirect
            FROM bot_redirections 
            WHERE tenant_id = :tenant_id 
            AND created_at BETWEEN :start_date AND :end_date
            GROUP BY DATE(created_at)
            ORDER BY date
        """, {
            'tenant_id': tenant_id,
            'start_date': start_date,
            'end_date': end_date
        }).fetchall()
        
        # Calculate metrics
        total_revenue = sum(row.daily_revenue for row in revenue_data)
        total_redirects = sum(row.redirects for row in revenue_data)
        avg_revenue_per_redirect = total_revenue / total_redirects if total_redirects > 0 else 0
        
        # Growth calculation
        if len(revenue_data) >= 2:
            current_period = sum(row.daily_revenue for row in revenue_data[-7:])  # Last 7 days
            previous_period = sum(row.daily_revenue for row in revenue_data[-14:-7])  # Previous 7 days
            growth_rate = ((current_period - previous_period) / previous_period * 100) if previous_period > 0 else 0
        else:
            growth_rate = 0
        
        return {
            'total_revenue': total_revenue,
            'total_redirects': total_redirects,
            'avg_revenue_per_redirect': avg_revenue_per_redirect,
            'growth_rate': growth_rate,
            'daily_data': [
                {
                    'date': row.date.isoformat(),
                    'revenue': row.daily_revenue,
                    'redirects': row.redirects,
                    'avg_revenue': row.avg_revenue_per_redirect
                }
                for row in revenue_data
            ],
            'period': period,
            'start_date': start_date.isoformat(),
            'end_date': end_date.isoformat()
        }
    
    def get_credit_page_performance(self, tenant_id: str) -> List[Dict[str, any]]:
        """Get credit page performance metrics."""
        return self.db.execute("""
            SELECT 
                cp.name as credit_page_name,
                cp.id as credit_page_id,
                COUNT(br.id) as total_redirects,
                SUM(br.revenue_generated) as total_revenue,
                AVG(br.revenue_generated) as avg_revenue,
                COUNT(CASE WHEN br.converted = true THEN 1 END) as conversions,
                (COUNT(CASE WHEN br.converted = true THEN 1 END) * 100.0 / COUNT(br.id)) as conversion_rate
            FROM credit_pages cp
            LEFT JOIN bot_redirections br ON cp.id = br.credit_page_id
            WHERE cp.tenant_id = :tenant_id
            GROUP BY cp.id, cp.name
            ORDER BY total_revenue DESC
        """, {'tenant_id': tenant_id}).fetchall()
    
    def get_bot_type_analysis(self, tenant_id: str) -> Dict[str, any]:
        """Analyze bot types and their revenue potential."""
        return self.db.execute("""
            SELECT 
                bot_type,
                COUNT(*) as count,
                SUM(revenue_generated) as total_revenue,
                AVG(revenue_generated) as avg_revenue,
                (COUNT(*) * 100.0 / (SELECT COUNT(*) FROM bot_redirections WHERE tenant_id = :tenant_id)) as percentage
            FROM bot_redirections 
            WHERE tenant_id = :tenant_id
            GROUP BY bot_type
            ORDER BY total_revenue DESC
        """, {'tenant_id': tenant_id}).fetchall()
