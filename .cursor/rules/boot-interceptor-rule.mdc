@app.route('/api/domains/verify', methods=['POST'])
@jwt_required
def verify_domain():
    """Verify a domain endpoint."""
    try:
        data = request.get_json()
        domain = data.get('domain')
        
        if not domain:
            return jsonify({'error': 'Domain is required'}), 400
        
        # Validate domain format
        if not is_valid_domain_format(domain):
            return jsonify({'error': 'Invalid domain format'}), 400
        
        # Perform verification
        result = domain_service.verify_domain(domain)
        
        # Log verification attempt
        log_verification_attempt(request.user_id, domain, result.verified)
        
        return jsonify({
            'success': True,
            'data': {
                'domain': result.domain,
                'verified': result.verified,
                'confidence': result.confidence,
                'details': result.details
            }
        }), 200
        
    except VerificationError as e:
        return jsonify({'error': str(e)}), 422
    except Exception as e:
        app.logger.error(f"Unexpected error: {e}")
        return jsonify({'error': 'Internal server error'}), 500
