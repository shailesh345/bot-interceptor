        if ml_result['is_bot']:
            detection_methods.append('machine_learning')
            bot_score += ml_result['confidence']
        
        is_bot = bot_score >= 0.6
        risk_score = min(bot_score, 1.0)
        
        return BotDetectionResult(
            is_bot=is_bot,
            confidence=bot_score,
            bot_type=bot_type,
            detection_methods=detection_methods,
            risk_score=risk_score,
            details=self._get_detection_details(request_data)
        )
    
    def _check_user_agent(self, user_agent: str) -> bool:
        """Check user agent for bot indicators."""
        bot_patterns = [
            r'bot', r'crawler', r'spider', r'scraper',
            r'headless', r'phantom', r'selenium',
            r'python-requests', r'curl', r'wget'
        ]
        
        user_agent_lower = user_agent.lower()
        return any(re.search(pattern, user_agent_lower) for pattern in bot_patterns)
    
    def _check_behavioral_patterns(self, request_data: Dict[str, any]) -> bool:
        """Analyze behavioral patterns for bot detection."""
        # Check request frequency
        ip = request_data.get('ip', '')
        current_time = time.time()
        
        if ip not in self.rate_limiters:
            self.rate_limiters[ip] = []
        
        # Clean old requests (older than 1 minute)
        self.rate_limiters[ip] = [
            req_time for req_time in self.rate_limiters[ip]
            if current_time - req_time < 60
        ]
        
        # Add current request
        self.rate_limiters[ip].append(current_time)
        
        # Check if too many requests
        if len(self.rate_limiters[ip]) > 30:  # More than 30 requests per minute
            return True
        
        return False
    
