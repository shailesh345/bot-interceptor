```python
# ✅ Service Test
import pytest
from unittest.mock import Mock, patch
from app.services.domain_verification import DomainVerificationService

class TestDomainVerificationService:
    def setup_method(self):
        self.service = DomainVerificationService({'test': 'config'})
    
    def test_verify_valid_domain(self):
        result = self.service.verify_domain("example.com")
        assert result.verified is True
        assert result.domain == "example.com"
        assert 0 <= result.confidence <= 1
    
    def test_verify_invalid_domain(self):
        result = self.service.verify_domain("invalid-domain")
        assert result.verified is False
        assert result.confidence < 0.5
    
    @patch('app.services.domain_verification.external_api_call')
    def test_verify_with_external_api(self, mock_api):
        mock_api.return_value = {'valid': True, 'score': 0.9}
        result = self.service.verify_domain("example.com")
        assert result.verified is True
        mock_api.assert_called_once_with("example.com")
