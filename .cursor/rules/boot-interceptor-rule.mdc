@app.route('/api/bot/redirect', methods=['POST'])
@jwt_required
@tenant_middleware()
@rate_limit(limit=100, per=60)  # 100 requests per minute
def redirect_bot():
    """Intercept bot and redirect to credit page with enhanced validation."""
    try:
        data = request.get_json()
        
        # Enhanced input validation
        if not data:
            return jsonify({'error': 'Request body is required'}), 400
        
        required_fields = ['url', 'user_agent', 'ip']
        missing_fields = [field for field in required_fields if not data.get(field)]
        
        if missing_fields:
            return jsonify({
                'error': 'Missing required fields',
                'missing_fields': missing_fields
            }), 400
        
        request_data = {
            'url': data.get('url', ''),
            'user_agent': data.get('user_agent', ''),
            'ip': data.get('ip', ''),
            'headers': data.get('headers', {}),
            'tenant_id': request.tenant_id,
            'method': request.method,
            'path': request.path,
            'referer': request.headers.get('Referer', ''),
            'country': get_country_from_ip(data.get('ip', '')),
            'device_type': detect_device_type(data.get('user_agent', ''))
        }
        
        # Perform bot redirection
        result = bot_redirection_service.intercept_and_redirect_bot(request_data)
        
        # Log redirection for billing
        log_bot_redirection(request.tenant_id, result.bot_id, result.credit_page_url, result.revenue_generated)
        
        return jsonify({
            'success': True,
            'data': {
                'bot_id': result.bot_id,
                'redirect_url': result.redirect_url,
                'credit_page_url': result.credit_page_url,
                'redirect_reason': result.redirect_reason,
                'timestamp': result.timestamp,
                'revenue_generated': result.revenue_generated
            },
            'message': 'Bot redirection successful'
        }), 200
        
    except ValidationError as e:
        current_app.logger.warning(f"Validation error in bot redirection: {e}")
        return jsonify({'error': 'Invalid request data', 'details': str(e)}), 400
    except RateLimitExceeded as e:
        current_app.logger.warning(f"Rate limit exceeded: {e}")
        return jsonify({'error': 'Rate limit exceeded', 'retry_after': e.retry_after}), 429
    except Exception as e:
        current_app.logger.error(f"Bot redirection failed: {e}")
        return jsonify({'error': 'Bot redirection failed', 'message': str(e)}), 500

@app.route('/api/bot/redirects', methods=['GET'])
@jwt_required
@tenant_middleware()
def get_bot_redirects():
    """Get recent bot redirects for tenant with pagination and filtering."""
    try:
        # Enhanced query parameters
        limit = min(request.args.get('limit', 50, type=int), 100)  # Max 100
        offset = request.args.get('offset', 0, type=int)
        start_date = request.args.get('start_date')
        end_date = request.args.get('end_date')
        bot_type = request.args.get('bot_type')
        
        redirects = bot_redirection_service.get_tenant_redirects(
            tenant_id=request.tenant_id,
            limit=limit,
            offset=offset,
            start_date=start_date,
            end_date=end_date,
            bot_type=bot_type
        )
        
        return jsonify({
            'success': True,
            'data': redirects,
            'pagination': {
                'limit': limit,
                'offset': offset,
                'total': len(redirects),
                'has_more': len(redirects) == limit
            }
        }), 200
        
    except Exception as e:
        current_app.logger.error(f"Failed to get bot redirects: {e}")
        return jsonify({'error': 'Failed to get bot redirects', 'message': str(e)}), 500
