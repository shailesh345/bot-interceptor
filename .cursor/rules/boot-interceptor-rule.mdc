```python
# ✅ Enhanced Service Pattern with Error Handling
from typing import Dict, List, Optional, Union
from flask import Flask, request, jsonify, current_app
from dataclasses import dataclass
import logging
import time
import uuid

@dataclass
class BotRedirectionResult:
    bot_id: str
    original_url: str
    redirect_url: str
    credit_page_url: str
    redirect_reason: str
    timestamp: float
    session_data: Dict[str, any]
    revenue_generated: float = 0.0

class EnhancedBotRedirectionService:
    """Enhanced SaaS bot redirection service for credit page monetization."""
    
    def __init__(self, config: Dict[str, any]):
        self.config = config
        self.credit_pages = self._load_credit_pages()
        self.redirect_rules = self._load_redirect_rules()
        self.session_manager = self._init_session_manager()
        self.logger = logging.getLogger(__name__)
    
    def intercept_and_redirect_bot(self, request_data: Dict[str, any]) -> BotRedirectionResult:
        """Intercept bot traffic and redirect to credit page with enhanced error handling."""
        start_time = time.time()
        
        try:
            # Detect if it's a bot
            bot_detection = self._detect_bot(request_data)
            
            if bot_detection.is_bot:
                # Generate unique bot session
                bot_id = str(uuid.uuid4())
                
                # Select appropriate credit page
                credit_page = self._select_credit_page(bot_detection)
                
                # Create redirect URL
                redirect_url = self._create_redirect_url(
                    original_url=request_data.get('url', ''),
                    credit_page_url=credit_page.url,
                    bot_id=bot_id
                )
                
                # Store session data
                session_data = self._store_bot_session(bot_id, request_data, credit_page)
                
                # Log redirection for billing
                revenue_generated = self._log_redirection_for_billing(bot_id, credit_page, request_data)
                
                # Log performance metrics
                processing_time = time.time() - start_time
                self.logger.info(f"Bot redirection completed in {processing_time:.3f}s", extra={
                    'bot_id': bot_id,
                    'processing_time': processing_time,
                    'revenue_generated': revenue_generated
                })
                
                return BotRedirectionResult(
                    bot_id=bot_id,
                    original_url=request_data.get('url', ''),
                    redirect_url=redirect_url,
                    credit_page_url=credit_page.url,
                    redirect_reason='bot_detected',
                    timestamp=time.time(),
                    session_data=session_data,
                    revenue_generated=revenue_generated
                )
            else:
                # Allow normal traffic
                return BotRedirectionResult(
                    bot_id='',
                    original_url=request_data.get('url', ''),
                    redirect_url=request_data.get('url', ''),
                    credit_page_url='',
                    redirect_reason='human_traffic',
                    timestamp=time.time(),
                    session_data={}
                )
                
        except Exception as e:
            self.logger.error(f"Bot redirection failed: {e}", extra={
                'request_data': request_data,
                'processing_time': time.time() - start_time
            })
            raise
    
    def _select_credit_page(self, bot_detection: BotDetectionResult) -> CreditPage:
        """Select appropriate credit page based on bot characteristics."""
        # Enhanced credit page selection logic
        if bot_detection.bot_type == 'scraper':
            return self.credit_pages.get('scraper_credit_page')
        elif bot_detection.bot_type == 'crawler':
            return self.credit_pages.get('crawler_credit_page')
        elif bot_detection.confidence > 0.8:
            return self.credit_pages.get('premium_credit_page')
        else:
            return self.credit_pages.get('default_credit_page')
    
    def _create_redirect_url(self, original_url: str, credit_page_url: str, bot_id: str) -> str:
        """Create redirect URL with enhanced tracking parameters."""
        params = {
            'bot_id': bot_id,
            'original_url': original_url,
            'redirect_time': int(time.time()),
            'session_id': str(uuid.uuid4()),
            'source': 'bot_interceptor'
        }
        
        param_string = '&'.join([f"{k}={v}" for k, v in params.items()])
        return f"{credit_page_url}?{param_string}"
    
    def _store_bot_session(self, bot_id: str, request_data: Dict[str, any], credit_page: CreditPage) -> Dict[str, any]:
        """Store bot session data for tracking with enhanced metadata."""
        session_data = {
            'bot_id': bot_id,
            'ip_address': request_data.get('ip', ''),
            'user_agent': request_data.get('user_agent', ''),
            'credit_page_id': credit_page.id,
            'created_at': time.time(),
            'status': 'redirected',
            'metadata': {
                'headers': request_data.get('headers', {}),
                'method': request_data.get('method', 'GET'),
                'path': request_data.get('path', ''),
                'referer': request_data.get('referer', ''),
                'country': request_data.get('country', 'unknown'),
                'device_type': request_data.get('device_type', 'unknown')
            }
        }
        
        # Store in database/cache with TTL
        self.session_manager.store_session(bot_id, session_data, ttl=3600)
        return session_data
    
    def _log_redirection_for_billing(self, bot_id: str, credit_page: CreditPage, request_data: Dict[str, any]) -> float:
        """Log redirection for billing and analytics with revenue calculation."""
        revenue_generated = credit_page.value_per_redirect
        
        billing_data = {
            'bot_id': bot_id,
            'credit_page_id': credit_page.id,
            'redirect_value': revenue_generated,
            'timestamp': time.time(),
            'ip_address': request_data.get('ip', ''),
            'bot_type': request_data.get('bot_type', 'unknown'),
            'user_agent': request_data.get('user_agent', ''),
            'session_id': str(uuid.uuid4())
        }
        
        # Send to billing service
        self.billing_service.log_redirection(billing_data)
        
        return revenue_generated

